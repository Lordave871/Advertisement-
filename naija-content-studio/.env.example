# Required. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (fast and cheap). Use claude-sonnet-5-5 for richer writing.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional. Comma-separated access codes. If set, visitors must enter one to generate content.
# Leave empty for open access. Give each paying customer their own code so you can revoke it later.
ACCESS_CODES=
